{
  "permissions": {
    "deny": [
      "Edit(/notes.md)"
    ],
    "ask": [
      "Edit(raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/harness.py\" shell-pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/harness.py\" main-md",
            "timeout": 60,
            "statusMessage": "Checking main.md"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/harness.py\" shell-post",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/harness.py\" stop",
            "timeout": 60,
            "statusMessage": "Finishing check"
          }
        ]
      }
    ]
  }
}

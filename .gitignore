# qmd search index (generated locally, not committed)
db/
.qmd/

# Large binary files — add to git LFS if you need version history on these
*.zip
*.tar.gz
*.gz
*.rar
*.7z
*.mp4
*.mov
*.avi

# Data files
*.csv
*.xlsx
*.parquet
*.h5
*.hdf5

# Note: PDFs in raw/ ARE tracked by default (they are your source documents).
# If PDFs are too large for git, set up git LFS:
#   git lfs install
#   git lfs track "raw/*.pdf"

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp

# Regenerable PDF page renders and text dumps (scripts/render_pdf_pages.py).
# Conclusions belong in wiki/papers/<paper>.md, not here.
figure_analysis/

# Local agent settings
.claude/settings.local.json

# Not open access (list non-open-access PDFs in raw/ by name here)

# Private drafts (for example blog or social media posts about the project); see AGENTS.md
docs/private/

# Export build files: main-export.md from scripts/export.py --write, the HTML and PDF made from it
main-export.md
main-export.html
main-export.pdf

# Python bytecode
__pycache__/
*.pyc
